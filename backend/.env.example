# ── Provider: groq | deepseek | openai | ollama ──────────────────────────────
MODEL_PROVIDER=groq

# ── Groq (testing/dev) ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_PLANNER_MODEL=llama-3.1-8b-instant

# ── DeepSeek (production, R1 has reasoning/thinking) ─────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_PLANNER_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_PLANNER_MODEL=gpt-4o-mini

# ── Ollama (local) ────────────────────────────────────────────────────────────
# 1. Install Ollama: https://ollama.com
# 2. Pull a model: ollama pull qwen2.5:14b
# 3. Set MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_PLANNER_MODEL=qwen2.5:7b

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/analytics_uploads
REPORTS_DIR=/tmp/analytics_reports
MAX_FILE_SIZE_MB=200

# ── CORS: add your Vercel URL ─────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]